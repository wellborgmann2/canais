    }
    (function syncTurbo() { if (typeof Android !== "undefined" && Android.getTurboState) { try { const s = Android.getTurboState(); turboEnabled = (s === true || s === "true"); _applyTurboUI(); } catch (e) { } } })();
    function _applyTurboUI() { const b = document.getElementById('turboBtn'); if (!b) return; turboEnabled ? b.classList.add('turbo-on') : b.classList.remove('turbo-on'); }

    function togglePasswordView() {
      const p = document.getElementById('password');
      const icon = p.parentElement.querySelector('.toggle-pass');
      if (p.type === "password") { p.type = "text"; icon.querySelector("use").setAttribute("href", "#i-eye"); } else { p.type = "password"; icon.querySelector("use").setAttribute("href", "#i-eye-off"); }
    }

    function copyId() {
      const uuid = document.getElementById('uuidDisplay');
      if (!uuid || uuid.textContent === "...") return;
      const text = uuid.textContent;
      if (navigator.clipboard) { navigator.clipboard.writeText(text).catch(e => console.error(e)); }
      else { const ta = document.createElement("textarea"); ta.value = text; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch (e) { } document.body.removeChild(ta); }
    }

    function switchTab(tabId) {
      document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
      const view = document.getElementById('view-' + tabId);
      if (view) view.classList.add('active');
      // Update bottom nav
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      const navMap = { home: 0, servers: 1, settings: 2, speed: 3 };
      const navItems = document.querySelectorAll('.nav-item');
      if (navItems[navMap[tabId]] !== undefined) navItems[navMap[tabId]].classList.add('active');
      // Log visibility
      const logView = document.getElementById('bottomLogView');
      if (logView) { if (tabId === 'home') { logView.classList.remove('hidden'); } else { logView.classList.add('hidden'); logView.classList.remove('expanded'); } }
    }

    function onBackPressed() {
      const logView = document.getElementById('bottomLogView');
      if (logView && logView.classList.contains('expanded')) { logView.classList.remove('expanded'); return true; }
      const homeView = document.getElementById('view-home');
      if (homeView && !homeView.classList.contains('active')) { switchTab('home'); return true; }
      return false;
    }
    window.onBackPressed = onBackPressed;

    function startTimer(elapsedSeconds) { stopTimer(); const initial = parseElapsedTime(elapsedSeconds); connectionStartTime = Math.floor(Date.now() / 1000) - initial; updateTimer(); timerInterval = setInterval(updateTimer, 1000); }
    function stopTimer() { if (timerInterval) { clearInterval(timerInterval); timerInterval = null; } }
    function parseElapsedTime(timeStr) { if (typeof timeStr === 'number') return timeStr; if (!timeStr) return 0; if (typeof timeStr === 'string' && timeStr.includes(':')) { const p = timeStr.split(':'); if (p.length === 3) return (+p[0]) * 3600 + (+p[1]) * 60 + (+p[2]); } return 0; }
    function updateTimer() { const diff = Math.max(0, Math.floor(Date.now() / 1000) - connectionStartTime); const h = Math.floor(diff / 3600); const m = Math.floor((diff % 3600) / 60); const s = diff % 60; const el = document.getElementById('timerDisplay'); if (el) el.textContent = pad(h) + ":" + pad(m) + ":" + pad(s); }
    function pad(n) { return n < 10 ? "0" + n : "" + n; }

    function toggleConnect() {
      const userIn = document.getElementById('username').value || savedUser;
      const passIn = document.getElementById('password').value || savedPass;
      const uuidIn = document.getElementById('v2ray_uuid').value || savedUuid;
      if (isConnected) { if (typeof Android !== "undefined") Android.disconnect(); }
      else if (isConnecting) { if (typeof Android !== "undefined") { if (Android.cancelConnection) Android.cancelConnection(); else Android.disconnect(); } setDisconnectedState(); }
      else {
        if (typeof Android !== "undefined") {
          const sel = allConfigs.find(c => c.id == selectedConfigId);
          if (sel && sel.mode === "XRAY") {
            if (!uuidIn) {
              showToast("Por favor, insira o UUID do Xray");
              return;
            }
            if (Android.setXrayUuid) Android.setXrayUuid(uuidIn);
            Android.connectXray(uuidIn, parseInt(selectedConfigId) || 0);
          } else {
            Android.connect(userIn, passIn, parseInt(selectedConfigId) || 0);
          }
        }
        setConnectingState();
      }
    }

    function setConnectedState(elapsed) {
      isConnected = true; isConnecting = false;
      const label = document.getElementById('statusText');
      const btn = document.getElementById('connectBtn');
      const btnIcon = document.getElementById('connectBtnIcon');
      const btnText = document.getElementById('connectBtnText');
      const shield = document.getElementById('shieldVisual');
      if (label) { label.textContent = 'STATUS: CONECTADO'; label.className = 'status-label-top connected'; }
      if (btn) { btn.classList.remove('connecting-state'); btn.classList.add('connected-state'); }
      if (btnIcon) btnIcon.querySelector("use").setAttribute("href", "#i-power");
      if (btnText) { btnText.textContent = 'Conectado'; btnText.className = 'conn-status-text connected'; }
      if (shield) { shield.classList.remove('connecting'); shield.classList.add('connected'); }
      const dl = document.getElementById('dlSpeed'); const ul = document.getElementById('ulSpeed');
      startTimer(elapsed);
    }

    function setDisconnectedState() {
      isConnected = false; isConnecting = false;
      const label = document.getElementById('statusText');
      const btn = document.getElementById('connectBtn');
      const btnIcon = document.getElementById('connectBtnIcon');
      const btnText = document.getElementById('connectBtnText');
      const shield = document.getElementById('shieldVisual');
      if (label) { label.textContent = 'STATUS: DESCONECTADO'; label.className = 'status-label-top'; }
      if (btn) { btn.classList.remove('connected-state', 'connecting-state'); }
      if (btnIcon) btnIcon.querySelector("use").setAttribute("href", "#i-bolt");
      if (btnText) { btnText.textContent = 'Não Conectado'; btnText.className = 'conn-status-text'; }
      if (shield) { shield.classList.remove('connected', 'connecting'); }
      const dl = document.getElementById('dlSpeed'); const ul = document.getElementById('ulSpeed');
      if (dl) dl.textContent = '--'; if (ul) ul.textContent = '--';
      stopTimer();
      const td = document.getElementById('timerDisplay'); if (td) td.textContent = '00:00:00';
    }

    function setConnectingState() {
      isConnecting = true; isConnected = false;
      const label = document.getElementById('statusText');
      const btn = document.getElementById('connectBtn');
      const btnIcon = document.getElementById('connectBtnIcon');
      const btnText = document.getElementById('connectBtnText');
      const shield = document.getElementById('shieldVisual');
      if (label) { label.textContent = 'STATUS: CONECTANDO...'; label.className = 'status-label-top connecting'; }
      if (btn) { btn.classList.remove('connected-state'); btn.classList.add('connecting-state'); }
      if (btnIcon) btnIcon.querySelector("use").setAttribute("href", "#i-sync");
      if (btnText) { btnText.textContent = 'Conectando...'; btnText.className = 'conn-status-text connecting'; }
      if (shield) { shield.classList.remove('connected'); shield.classList.add('connecting'); }
    }

    function renderServerList(configs) {
      if (typeof configs === 'string') { try { configs = JSON.parse(configs); } catch (e) { configs = []; } }
      allConfigs = configs || [];
      const container = document.getElementById('serverListContainer');
      if (!container) return; container.innerHTML = '';
      if (allConfigs.length === 0) return;
      const groups = {};
      allConfigs.forEach(conf => {
        const catName = (conf.category && conf.category.name) || "Outros";
        const catColor = (conf.category && conf.category.color) || conf.categoryColor || "#5A6B87";
        const catSort = (conf.category && conf.category.sorter !== undefined) ? conf.category.sorter : 999;
        if (!groups[catName]) groups[catName] = { name: catName, color: catColor, sorter: catSort, items: [] };
        groups[catName].items.push(conf);
      });
      Object.values(groups).sort((a, b) => a.sorter - b.sorter).forEach(group => {
        const catDiv = document.createElement('div'); catDiv.className = 'server-cat-label';
        catDiv.innerHTML = '<div class="cat-line"></div><span style="flex-shrink:0;color:' + group.color + '">' + group.name + '</span><div class="cat-line"></div>';
        container.appendChild(catDiv);
        const groupCard = document.createElement('div'); groupCard.className = 'server-group-card';
        group.items.forEach(conf => {
          const validIcon = conf.icon && conf.icon !== 'null' && conf.icon !== 'undefined' && conf.icon.length > 0;
          const row = document.createElement('div'); row.className = 'server-row';
          row.onclick = () => selectServer(conf.id, conf.name, conf.description || '', conf.icon || '');
          row.innerHTML = '<div class="server-flag-wrap">' + (validIcon ? '<img src="' + conf.icon + '" alt="" onerror="imgError(this)">' : '<svg style="width:16px;height:16px;fill:var(--text-dim);"><use href="#icon-globe"/></svg>') + '</div><div class="server-info"><div class="server-name">' + conf.name + '</div>' + (conf.description ? '<div class="server-desc">' + conf.description + '</div>' : '') + '</div><svg class="icon" style="width:18px;height:18px;color:var(--text-dim);"><use href="#i-chevron-r"/></svg>';
          groupCard.appendChild(row);
        });
        container.appendChild(groupCard);
      });
    }

    function selectServer(id, name, details, icon) {
      selectedConfigId = id;
      const nameEl = document.getElementById('selectedName'); if (nameEl) nameEl.textContent = name;
      const det = document.getElementById('selectedDetails'); if (det) det.textContent = details || '';
      const validIcon = icon && icon !== 'null' && icon !== 'undefined' && icon.length > 0;
      const badgeWrap = document.getElementById('serverBadgeFlagWrap');
      if (badgeWrap) { if (validIcon) { badgeWrap.innerHTML = '<img src="' + icon + '" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" onerror="imgError(this)">'; } else { badgeWrap.innerHTML = '<svg class="icon" style="width:22px;height:22px;"><use href="#i-globe"/></svg>'; } }
      const smallIcon = document.getElementById('selectedIconSmall');
      const hiddenIcon = document.getElementById('selectedIcon');
      if (smallIcon) { smallIcon.src = validIcon ? icon : ''; smallIcon.style.display = validIcon ? 'block' : 'none'; }
      if (hiddenIcon) { hiddenIcon.src = validIcon ? icon : ''; }

      // Toggle input visibility based on mode
      const sel = allConfigs.find(c => c.id == id);
      const userGroup = document.getElementById('userGroup');
      const passGroup = document.getElementById('passGroup');
      const uuidGroup = document.getElementById('uuidGroup');
      if (sel && sel.mode === "XRAY") {
        if (userGroup) userGroup.classList.add('hidden');
        if (passGroup) passGroup.classList.add('hidden');
        if (uuidGroup) uuidGroup.classList.remove('hidden');
      } else {
        if (userGroup) userGroup.classList.remove('hidden');
        if (passGroup) passGroup.classList.remove('hidden');
        if (uuidGroup) uuidGroup.classList.add('hidden');
      }

      switchTab('home');
    }

    function toggleBottomLog() { const el = document.getElementById('bottomLogView'); el.classList.toggle('expanded'); if (el.classList.contains('expanded')) { const c = document.getElementById('fullLogContent'); if (c) c.scrollTop = c.scrollHeight; } }
    function _buildLogNode(msg) { const row = document.createElement('div'); row.className = 'log-entry'; row.innerHTML = msg; return row; }
    function logMessage(msg) { const pt = document.getElementById('logPreviewText'); if (pt) pt.textContent = msg.replace(/<[^>]*>?/gm, ''); const c = document.getElementById('fullLogContent'); if (!c) return; c.appendChild(_buildLogNode(msg)); if (c.scrollHeight - c.scrollTop - c.clientHeight < 80) c.scrollTop = c.scrollHeight; }
    function _bulkRenderLogs(logs) { const c = document.getElementById('fullLogContent'); if (!c) return; const frag = document.createDocumentFragment(); logs.forEach(l => { if (l.message) frag.appendChild(_buildLogNode(l.message)); }); c.innerHTML = ''; c.appendChild(frag); c.scrollTop = c.scrollHeight; if (logs.length > 0) { const last = logs[logs.length - 1]; const pt = document.getElementById('logPreviewText'); if (pt && last.message) pt.textContent = last.message.replace(/<[^>]*>?/gm, ''); } }
    function openLogs() { const el = document.getElementById('bottomLogView'); if (el) { el.classList.remove('hidden'); el.classList.add('expanded'); } }
    function closeLogs() { const el = document.getElementById('bottomLogView'); if (el) el.classList.remove('expanded'); }
    function clearLogs() { if (typeof Android !== "undefined") Android.clearLogs(); const c = document.getElementById('fullLogContent'); if (c) c.innerHTML = ''; const pt = document.getElementById('logPreviewText'); if (pt) pt.textContent = 'Logs limpos.'; }
    function copyLogs() { if (typeof Android !== "undefined") Android.copyLogs(); }

    function startSpeedTest() {
      const btn = document.querySelector('.start-test-btn'); if (btn && btn.disabled) return;
      if (btn) { document.getElementById('speedBtnText').textContent = 'Testando...'; btn.disabled = true; btn.style.opacity = '0.6'; }
      const fill = document.getElementById('speedRingFill'); if (fill) fill.style.strokeDashoffset = '502';
      document.getElementById('speedNum').textContent = '--';
      if (typeof Android !== "undefined" && Android.runSpeedTest) { Android.runSpeedTest(); }
      else { setTimeout(() => { window.onSpeedTestResult(JSON.stringify({ download: "15.5", upload: "5.2", ping: "45", jitter: "12", loss: "0" })); }, 2000); }
    }

    window.onSpeedTestResult = function (resultStr) {
      const btn = document.querySelector('.start-test-btn');
      const resetBtn = (label) => { if (btn) { document.getElementById('speedBtnText').textContent = label; btn.disabled = false; btn.style.opacity = '1'; } };
      if (typeof resultStr === 'string' && resultStr.trim().charAt(0) === '{') {
        try {
          const res = JSON.parse(resultStr); const dlVal = parseFloat(res.download) || 0;
          document.getElementById('speedNum').textContent = res.download || '--';
          document.getElementById('speedPing').textContent = (res.ping || '--') + ' ms';
          document.getElementById('speedJitter').textContent = (res.jitter || '--') + ' ms';
          document.getElementById('speedLoss').textContent = (res.loss || '0') + ' %';
          const dlStat = document.getElementById('dlSpeed'); const ulStat = document.getElementById('ulSpeed');
          if (dlStat) dlStat.textContent = (res.download || '--') + ' Mbps';
          if (ulStat) ulStat.textContent = (res.upload || '--') + ' Mbps';
          const fill = document.getElementById('speedRingFill');
          if (fill) { const pct = Math.min(dlVal / 100, 1); fill.style.strokeDashoffset = 502 - (502 * pct); }
          resetBtn('Testar Novamente');
        } catch (e) { resetBtn('Erro'); }
      } else { document.getElementById('speedNum').textContent = resultStr || '--'; resetBtn('Testar Novamente'); }
    };

    // FALLBACK ICON
    function imgError(img) {
      img.src = "data:image/svg+xml;base64,";
      img.onerror = null;
    }
    function updateConfig() { if (typeof Android !== "undefined") Android.updateConfig(); showToast('Atualizando configurações...'); }
    function check() { const user = document.getElementById('username').value || savedUser; if (typeof Android !== "undefined") Android.checkValidity(user); }

    window.onStatusChanged = function (status, elapsed) { if (status === "CONNECTED") setConnectedState(elapsed); else if (status === "CONNECTING") setConnectingState(); else setDisconnectedState(); };
    window.onUserDataLoaded = function (user, pass, uuid) { savedUser = user || ""; savedPass = pass || ""; savedUuid = uuid || ""; document.getElementById('username').value = savedUser; document.getElementById('password').value = savedPass; document.getElementById('v2ray_uuid').value = savedUuid; };
    window.onXrayUuidLoaded = function (uuid) { savedUuid = uuid || ""; const el = document.getElementById('v2ray_uuid'); if (el) el.value = savedUuid; };
    window.onConfigsLoaded = function (configs) { renderServerList(configs); if (allConfigs && allConfigs.length > 0) { if (!selectedConfigId || selectedConfigId === 0) selectedConfigId = allConfigs[0].id; const sel = allConfigs.find(c => c.id == selectedConfigId); if (sel) selectServer(sel.id, sel.name, sel.description, sel.icon); } };
    window.onLogsLoaded = function (logs) { _bulkRenderLogs(Array.isArray(logs) ? logs : []); };
    window.onLogsReceived = function (logs) { if (Array.isArray(logs)) { logs.forEach(l => { if (l.message) logMessage(l.message); }); } else { logMessage(logs); } };
    window.updateServers = function (configs) { window.onConfigsLoaded(configs); showToast("Lista de servidores atualizada!"); };
    window.setServers = function (configs) { window.onConfigsLoaded(configs); };
    window.onUpdateConfig = function (configs) { window.onConfigsLoaded(configs); showToast("Configurações atualizadas!"); };
    window.onUpdateMessage = function (msg) { showToast(msg); };

    window.showToast = function (msg) {
      if (typeof Android !== "undefined" && Android.showToast) {
        Android.showToast(msg);
      }
    };

    window.onTrafficChanged = function (download, upload) { const dl = document.getElementById('dlSpeed'); const ul = document.getElementById('ulSpeed'); if (dl) dl.textContent = download; if (ul) ul.textContent = upload; };
    window.onSelectedConnectionLoaded = function (id) { selectedConfigId = id; if (!allConfigs) return; const conf = allConfigs.find(c => c.id == id); if (conf) { selectServer(conf.id, conf.name, conf.description, conf.icon); } else if (id == 0 || id == -1) { document.getElementById('selectedName').textContent = "Fastest Server"; } };

    window.hoxCheckuser = function (jsonStr) {
      try {
        const data = typeof jsonStr === 'string' ? JSON.parse(jsonStr) : jsonStr;
        const dateEl = document.getElementById('valDate'); const yearEl = document.getElementById('valYear'); const daysEl = document.getElementById('valDays');
        if (data.expiration_date) { const parts = data.expiration_date.split('/'); if (parts.length === 3) { const months = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"]; const month = months[parseInt(parts[1]) - 1] || parts[1]; dateEl.textContent = month + ' ' + parts[0]; yearEl.textContent = parts[2]; } else { dateEl.textContent = data.expiration_date; yearEl.textContent = ""; } }
        if (data.expiration_days) daysEl.textContent = data.expiration_days + ' Dias';
        document.getElementById('validityModal').classList.add('active');
      } catch (e) { console.error("Error parsing checkuser data", e); }
    };
    window.closeValidityModal = function (e) { document.getElementById('validityModal').classList.remove('active'); };
    window.renewAction = function () { if (typeof Android !== "undefined" && Android.openUrl) { /* Android.openUrl("https://..."); */ } closeValidityModal(); };

    try {
      Android.setSystemBarsColor("#E7EFF8");
      showToast("cor de fundo aplicada")
    } catch (error) {
      showToast("Erro setSystemBarsColor")
    }

    function chat() {
      Android.openChat();
    }

    function updateAppName(name) {
      const header = document.getElementById('title');
      const titleTag = document.getElementById('appTitle');
      if (header) header.textContent = name;
      if (titleTag) titleTag.textContent = name;
    }

    window.onAppNameLoaded = function (name) {
      updateAppName(name);
    };

    (function () {
      try {
        if (window.Android && window.Android.getAppName) {
          const name = window.Android.getAppName();
          if (name) updateAppName(name);
        }
      } catch (error) { }
    })()
  </script>
</body>

