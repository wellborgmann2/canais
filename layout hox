<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title id="appTitle">...</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
    rel="stylesheet">

  <style>
    .icon {
      width: 1em;
      height: 1em;
      fill: currentColor;
      display: inline-block;
      vertical-align: -0.125em;
      flex-shrink: 0;
    }

    :root {
      --bg: #c30f0f;
      --surface: #FFFFFF;
      --surface2: #EDF2F9;
      --surface3: #D8E2EE;
      --primary: #4A7BF7;
      --primary-light: rgba(74, 123, 247, 0.12);
      --green: #34C759;
      --green-light: rgba(52, 199, 89, 0.12);
      --orange: #F5A623;
      --orange-light: rgba(245, 166, 35, 0.12);
      --red: #E74C3C;
      --text: #1C2A48;
      --text-sec: #6B7FA3;
      --text-dim: #A0ADBE;
      --border: rgba(0, 0, 0, 0.04);
      --neumorphic-shadow: 8px 8px 20px rgba(163, 177, 198, 0.5), -8px -8px 20px rgba(255, 255, 255, 0.9);
      --neumorphic-shadow-sm: 4px 4px 10px rgba(163, 177, 198, 0.35), -4px -4px 10px rgba(255, 255, 255, 0.8);
      --neumorphic-inset: inset 3px 3px 8px rgba(163, 177, 198, 0.4), inset -3px -3px 8px rgba(255, 255, 255, 0.7);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      font-family: 'Poppins', sans-serif;
      outline: none;
      user-select: none;
    }

    html,
    body {
      background: var(--bg);
      color: var(--text);
      height: 100%;
      width: 100%;
      overflow: hidden;
    }

    ::-webkit-scrollbar {
      width: 3px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--surface3);
      border-radius: 99px;
    }

    .phone-frame {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--bg);
      position: relative;
    }

    .app-content {
      flex: 1;
      padding: 0 24px;
      padding-top: calc(10px + env(safe-area-inset-top, 0px));
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 1;
      -webkit-overflow-scrolling: touch;
    }

    .view-section {
      display: none;
      flex-direction: column;
      height: 100%;
    }

    .view-section.active {
      display: flex;
      animation: viewIn 0.25s ease both;
    }

    @keyframes viewIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* TOPBAR */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0 8px;
      flex-shrink: 0;
    }

    .topbar-left {
      cursor: pointer;
      padding: 8px;
    }

    .topbar-left .material-icons-round {
      font-size: 26px;
      color: var(--text-sec);
    }

    .topbar-center {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.3px;
    }

    .topbar-right {
      width: 40px;
      height: 40px;
      background: var(--primary);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .topbar-right .material-icons-round {
      font-size: 20px;
      color: #fff;
    }

    /* STATUS TEXT */
    .status-text-row {
      text-align: center;
      padding: 14px 0 4px;
    }

    .status-label-top {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--text-dim);
    }

    .status-label-top.connected {
      color: var(--green);
    }

    .status-label-top.connecting {
      color: var(--orange);
    }

    /* POWER CIRCLE */
    .power-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 10px 0 6px;
    }

    .power-circle-outer {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: var(--bg);
      box-shadow: var(--neumorphic-shadow);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .power-circle-mid {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: var(--bg);
      box-shadow: var(--neumorphic-inset);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .power-circle-inner {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: linear-gradient(145deg, var(--primary), #5B8AF9);
      box-shadow: 0 6px 24px rgba(74, 123, 247, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s;
      border: none;
    }

    .power-circle-inner:active {
      transform: scale(0.95);
    }

    .power-circle-inner .material-icons-round {
      font-size: 42px;
      color: #fff;
    }

    .power-circle-inner.connected-state {
      background: linear-gradient(145deg, var(--green), #27AE60);
      box-shadow: 0 6px 24px rgba(52, 199, 89, 0.4);
    }

    .power-circle-inner.connecting-state {
      background: linear-gradient(145deg, var(--orange), #D4920D);
      box-shadow: 0 6px 24px rgba(245, 166, 35, 0.4);
    }

    /* Progress ring around outer circle */
    .ring-svg {
      position: absolute;
      width: 180px;
      height: 180px;
      transform: rotate(-90deg);
      pointer-events: none;
    }

    .ring-track {
      fill: none;
      stroke: transparent;
      stroke-width: 3;
    }

    .ring-fill {
      fill: none;
      stroke: var(--primary);
      stroke-width: 3;
      stroke-linecap: round;
      stroke-dasharray: 502;
      stroke-dashoffset: 502;
      transition: stroke-dashoffset 0.5s;
      opacity: 0;
    }

    .power-circle-outer.connecting .ring-fill {
      opacity: 1;
      stroke: var(--orange);
      animation: ring-spin 2s linear infinite;
    }

    .power-circle-outer.connected .ring-fill {
      opacity: 1;
      stroke: var(--green);
      stroke-dashoffset: 0;
      animation: none;
    }

    @keyframes ring-spin {
      0% {
        stroke-dashoffset: 502;
      }

      50% {
        stroke-dashoffset: 150;
      }

      100% {
        stroke-dashoffset: 502;
      }
    }

    /* Connection status text below button */
    .connection-status {
      text-align: center;
      margin: 14px 0 2px;
    }

    .conn-status-text {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--primary);
    }

    .conn-status-text.connected {
      color: var(--green);
    }

    .conn-status-text.connecting {
      color: var(--orange);
    }

    .conn-timer {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--text-dim);
      margin-top: 2px;
    }

    /* CREDENTIAL FIELDS */
    .cred-section {
      padding: 10px 0 6px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .cred-field {
      background: var(--surface);
      border-radius: 16px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      box-shadow: var(--neumorphic-shadow-sm);
    }

    .cred-field .material-icons-round {
      font-size: 22px;
      color: var(--text-dim);
      flex-shrink: 0;
    }

    .cred-field input {
      flex: 1;
      border: none;
      background: transparent;
      font-family: 'Poppins', sans-serif;
      font-size: 0.92rem;
      font-weight: 500;
      color: var(--text);
    }

    .cred-field input::placeholder {
      color: var(--text-dim);
    }

    .cred-field .toggle-pass {
      cursor: pointer;
      color: var(--text-dim);
    }

    /* ACTION BUTTONS */
    .action-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      padding: 12px 0;
    }

    .action-btn {
      background: var(--surface);
      border-radius: 16px;
      padding: 16px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: var(--neumorphic-shadow-sm);
      transition: all 0.2s;
      border: none;
    }

    .action-btn:active {
      transform: scale(0.96);
      box-shadow: var(--neumorphic-inset);
    }

    .action-btn .material-icons-round {
      font-size: 24px;
      color: var(--primary);
    }

    .action-btn span {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-sec);
    }

    /* SERVER SELECT */
    .server-card {
      background: var(--surface);
      border-radius: 16px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      cursor: pointer;
      box-shadow: var(--neumorphic-shadow-sm);
      margin-bottom: 10px;
      transition: all 0.2s;
    }

    .server-card:active {
      transform: scale(0.98);
    }

    .srv-flag {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--surface2);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .srv-flag img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .srv-flag .material-icons-round {
      font-size: 22px;
      color: var(--text-dim);
    }

    .srv-info {
      flex: 1;
      min-width: 0;
    }

    .srv-optimal {
      font-size: 0.62rem;
      color: var(--primary);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .srv-name {
      font-size: 0.95rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .srv-signal {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .srv-signal .material-icons-round {
      font-size: 20px;
      color: var(--primary);
    }

    .srv-signal .chevron {
      font-size: 20px;
      color: var(--text-dim);
    }

    /* BOTTOM NAV */
    .bottom-nav {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      background: var(--surface);
      border-top: 1px solid var(--border);
      padding: 6px 0 calc(6px + env(safe-area-inset-bottom, 0px));
      z-index: 10;
      flex-shrink: 0;
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 8px 4px;
      cursor: pointer;
      transition: color 0.2s;
      color: var(--text-dim);
    }

    .nav-item.active {
      color: var(--primary);
    }

    .nav-item .material-icons-round {
      font-size: 24px;
    }

    .nav-item span {
      font-size: 0.62rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    /* SERVERS VIEW */
    .view-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0 16px;
      flex-shrink: 0;
    }

    .back-btn {
      width: 38px;
      height: 38px;
      background: var(--surface);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: var(--neumorphic-shadow-sm);
      flex-shrink: 0;
      border: none;
      transition: all 0.2s;
    }

    .back-btn:active {
      transform: scale(0.95);
    }

    .back-btn .material-icons-round {
      font-size: 20px;
      color: var(--text);
    }

    .view-title {
      font-size: 1.1rem;
      font-weight: 700;
      flex: 1;
    }

    .server-scroll {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 20px;
    }

    .server-cat-label {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 14px 2px 8px;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-dim);
    }

    .cat-line {
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .server-group-card {
      background: var(--surface);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--neumorphic-shadow-sm);
    }

    .server-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      transition: background 0.15s;
    }

    .server-row:last-child {
      border-bottom: none;
    }

    .server-row:active {
      background: var(--surface2);
    }

    .server-flag-wrap {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--surface2);
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .server-flag-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .server-flag-wrap svg {
      width: 16px;
      height: 16px;
      fill: var(--text-dim);
    }

    .server-info {
      flex: 1;
      min-width: 0;
    }

    .server-name {
      font-size: 0.88rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .server-desc {
      font-size: 0.72rem;
      color: var(--text-dim);
      margin-top: 2px;
    }

    .server-arrow {
      width: 16px;
      height: 16px;
      fill: var(--text-dim);
      flex-shrink: 0;
    }

    /* SPEED */
    .speed-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 0 60px;
      gap: 24px;
    }

    .speed-ring-wrap {
      position: relative;
      width: 200px;
      height: 200px;
    }

    .speed-ring-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }

    .speed-ring-track {
      fill: none;
      stroke: var(--surface3);
      stroke-width: 12;
    }

    .speed-ring-fill {
      fill: none;
      stroke: url(#speedGrad3);
      stroke-width: 12;
      stroke-linecap: round;
      stroke-dasharray: 502;
      stroke-dashoffset: 502;
      transition: stroke-dashoffset 1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .speed-ring-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .speed-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 2.4rem;
      font-weight: 700;
    }

    .speed-unit-label {
      font-size: 0.75rem;
      color: var(--text-dim);
      letter-spacing: 1px;
    }

    .speed-meta {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      width: 100%;
    }

    .speed-meta-item {
      background: var(--surface);
      border-radius: 14px;
      padding: 14px;
      text-align: center;
      box-shadow: var(--neumorphic-shadow-sm);
    }

    .speed-meta-label {
      font-size: 0.65rem;
      color: var(--text-dim);
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .speed-meta-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      font-weight: 700;
    }

    .start-test-btn {
      width: 100%;
      max-width: 280px;
      height: 50px;
      background: var(--surface);
      border: 2px solid var(--primary);
      border-radius: 14px;
      color: var(--primary);
      font-family: 'Poppins', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: var(--neumorphic-shadow-sm);
      transition: all 0.2s;
    }

    .start-test-btn:active {
      transform: scale(0.98);
    }

    .start-test-btn .material-icons-round {
      font-size: 20px;
    }

    /* BOTTOM LOG */
    .bottom-log-view {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 300px;
      background: var(--surface);
      border-radius: 20px 20px 0 0;
      transform: translateY(calc(100% - 48px));
      transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 2000;
      display: flex;
      flex-direction: column;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
    }

    .bottom-log-view.expanded {
      transform: translateY(0);
    }

    .bottom-log-view.hidden {
      transform: translateY(100%) !important;
      pointer-events: none;
    }

    .log-handle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 18px 0;
      cursor: pointer;
      flex-shrink: 0;
      height: 48px;
    }

    .log-handle-left {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
      min-width: 0;
    }

    .log-dot {
      width: 7px;
      height: 7px;
      background: var(--primary);
      border-radius: 50%;
      flex-shrink: 0;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.3);
      }
    }

    .log-preview-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      color: var(--text-sec);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .log-actions {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }

    .log-action-btn {
      width: 28px;
      height: 28px;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .log-action-btn:active {
      transform: scale(0.88);
    }

    .log-action-btn.red {
      background: rgba(231, 76, 60, 0.1);
      color: var(--red);
    }

    .log-action-btn.green {
      background: var(--green-light);
      color: var(--green);
    }

    .log-action-btn .material-icons-round {
      font-size: 16px;
    }

    .full-log-content {
      flex: 1;
      overflow-y: auto;
      padding: 10px 18px 18px;
      margin-top: 8px;
      color: black;
    }

    #password {
      width: 90%;
    }

    .log-entry {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      color: black;
      padding: 4px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.03);
      line-height: 1.5;
    }

    .log-entry font[color="white"],
    .log-entry font[color="#ffffff"],
    .log-entry font[color="#FFFFFF"] {
      color: black !important;
    }

    /* MODAL */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.25);
      backdrop-filter: blur(12px);
      z-index: 4000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-sheet {
      background: var(--surface);
      border-radius: 24px;
      padding: 28px 20px 24px;
      width: 100%;
      max-width: 400px;
      margin: auto;
      animation: sheetUp 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
      box-shadow: var(--neumorphic-shadow);
    }

    @keyframes sheetUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modal-icon-wrap {
      width: 64px;
      height: 64px;
      background: var(--primary-light);
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }

    .modal-icon-wrap .material-icons-round {
      font-size: 32px;
      color: var(--primary);
    }

    .modal-title {
      font-size: 1.3rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 6px;
    }

    .modal-desc {
      font-size: 0.85rem;
      color: var(--text-sec);
      text-align: center;
      margin-bottom: 22px;
    }

    .modal-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 22px;
    }

    .modal-stat {
      background: var(--surface2);
      border-radius: 14px;
      padding: 14px;
    }

    .modal-stat-label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-dim);
      margin-bottom: 6px;
    }

    .modal-stat-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.1rem;
      font-weight: 700;
    }

    .modal-stat-sub {
      font-size: 0.72rem;
      color: var(--primary);
      margin-top: 2px;
    }

    .modal-renew-btn {
      width: 100%;
      height: 52px;
      background: linear-gradient(135deg, var(--primary), #5B8AF9);
      border: none;
      border-radius: 14px;
      color: #fff;
      font-family: 'Poppins', sans-serif;
      font-size: 0.95rem;
